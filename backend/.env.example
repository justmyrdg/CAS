# Postgres connection used by Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/cogniview?schema=public"

# HTTP server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS="http://localhost:1200,http://localhost:1201,http://localhost:1202"

# JWT secrets — use long random strings in real environments, and use
# DIFFERENT secrets for access vs refresh tokens.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Where uploaded AR models, trigger pictures and lesson images are kept.
#   local      -> backend/uploads/ (development)
#   cloudinary -> Cloudinary (production; hosts like Render lose local files on every deploy)
# For cloudinary, copy the "API environment variable" from the Cloudinary dashboard (Settings -> API Keys).
# Existing files are copied across with `npm run storage:migrate`.
STORAGE_DRIVER="local"
# CLOUDINARY_URL="cloudinary://<api key>:<api secret>@<cloud name>"
# CLOUDINARY_FOLDER="cogniview"

# Bootstrap admin created by `npm run seed` (only used by the seed script)
SEED_ADMIN_EMAIL="admin@cogniview.edu"
SEED_ADMIN_NAME="Root Admin"
SEED_ADMIN_EMPLOYEE_ID="00001"
